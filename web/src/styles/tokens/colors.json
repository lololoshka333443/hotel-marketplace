{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Hotel marketplace tokens — paper and ink: warm parchment page, near-black type, almost no accent. Every semantic pair is verified WCAG 2.2 (4.5:1 text, 3:1 UI) by scripts/gen_palette.py. Light only: the mood is a printed city guide, not a dashboard.",
  "primitive": {
    "$description": "The chosen few — never reference directly in components",
    "paper": {
      "$type": "color",
      "$value": "#F4F0E8",
      "$description": "The page — warm parchment, never pure white"
    },
    "surface": {
      "$type": "color",
      "$value": "#FBF9F5",
      "$description": "Cards and inputs"
    },
    "ink": {
      "$type": "color",
      "$value": "#1C1916",
      "$description": "Type and the primary button"
    },
    "ink-soft": {
      "$type": "color",
      "$value": "#5C564E",
      "$description": "Secondary type, eyebrows"
    },
    "muted": {
      "$type": "color",
      "$value": "#8A8175",
      "$description": "Control boundaries, disabled type"
    },
    "line": {
      "$type": "color",
      "$value": "#E4DCD0",
      "$description": "Decorative hairlines — no contrast role"
    },
    "line-strong": {
      "$type": "color",
      "$value": "#CFC5B6",
      "$description": "A stronger decorative hairline"
    },
    "wash": {
      "$type": "color",
      "$value": "#EBE4D8",
      "$description": "Hover, sunken surfaces, disabled fill"
    },
    "danger": {
      "$type": "color",
      "$value": "#8C3A32",
      "$description": "The one accent, and it is rare"
    },
    "success-text": {
      "$type": "color",
      "$value": "#3E5A43"
    },
    "success-bg": {
      "$type": "color",
      "$value": "#E9EBE2"
    },
    "warning-text": {
      "$type": "color",
      "$value": "#6E5421"
    },
    "warning-bg": {
      "$type": "color",
      "$value": "#F0E8D9"
    }
  },
  "semantic": {
    "$description": "Purpose-based tokens — use these in design and code",
    "action": {
      "primary": {
        "$type": "color",
        "$value": "#1C1916",
        "$description": "ink; button-text on it 15.68:1"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "#2A2622",
        "$description": "ink warmed a step"
      },
      "primary-active": {
        "$type": "color",
        "$value": "#12100E"
      },
      "secondary": {
        "$type": "color",
        "$value": "transparent",
        "$description": "Outline button: border + ink type"
      },
      "secondary-hover": {
        "$type": "color",
        "$value": "#EBE4D8",
        "$description": "The border stays; the fill washes"
      },
      "destructive": {
        "$type": "color",
        "$value": "#8C3A32",
        "$description": "Rare — destructive only"
      },
      "destructive-hover": {
        "$type": "color",
        "$value": "#792822"
      }
    },
    "feedback": {
      "success-bg": {
        "$type": "color",
        "$value": "#E9EBE2"
      },
      "success-text": {
        "$type": "color",
        "$value": "#3E5A43"
      },
      "warning-bg": {
        "$type": "color",
        "$value": "#F0E8D9"
      },
      "warning-text": {
        "$type": "color",
        "$value": "#6E5421"
      },
      "error-bg": {
        "$type": "color",
        "$value": "#F1E2DD"
      },
      "error-text": {
        "$type": "color",
        "$value": "#8C3A32"
      },
      "info-bg": {
        "$type": "color",
        "$value": "#EBE4D8"
      },
      "info-text": {
        "$type": "color",
        "$value": "#5C564E"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#1C1916",
        "$description": "15.40:1 on paper"
      },
      "secondary": {
        "$type": "color",
        "$value": "#5C564E",
        "$description": "6.38:1 on paper"
      },
      "tertiary": {
        "$type": "color",
        "$value": "#726a5e",
        "$description": "derived: muted darkened to 4.5:1 on paper (4.69:1)"
      },
      "disabled": {
        "$type": "color",
        "$value": "#8A8175",
        "$description": "exempt from 4.5:1 — disabled, not content"
      },
      "on-action": {
        "$type": "color",
        "$value": "#F6F2EB",
        "$description": "15.68:1 on ink"
      },
      "link": {
        "$type": "color",
        "$value": "#1C1916",
        "$description": "ink, not an accent — affordance comes from the underline"
      },
      "link-hover": {
        "$type": "color",
        "$value": "#5C564E"
      }
    },
    "surface": {
      "page": {
        "$type": "color",
        "$value": "#F4F0E8"
      },
      "card": {
        "$type": "color",
        "$value": "#FBF9F5"
      },
      "raised": {
        "$type": "color",
        "$value": "#FBF9F5"
      },
      "sunken": {
        "$type": "color",
        "$value": "#EBE4D8"
      },
      "overlay": {
        "$type": "color",
        "$value": "rgba(28, 25, 22, 0.45)",
        "$description": "Modal/drawer backdrop"
      },
      "disabled": {
        "$type": "color",
        "$value": "#EBE4D8"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "#E4DCD0",
        "$description": "hairline — cards, dividers; no contrast role"
      },
      "strong": {
        "$type": "color",
        "$value": "#8A8175",
        "$description": "control boundary, 3.37:1 (3:1 UI)"
      },
      "focus": {
        "$type": "color",
        "$value": "#1C1916",
        "$description": "Focus turns the border ink, not blue"
      },
      "error": {
        "$type": "color",
        "$value": "#8C3A32"
      }
    },
    "interactive": {
      "hover-overlay": {
        "$type": "color",
        "$value": "#EBE4D8",
        "$description": "Hover shifts to wash, nothing else moves"
      },
      "active-overlay": {
        "$type": "color",
        "$value": "#CFC5B6"
      },
      "selected-bg": {
        "$type": "color",
        "$value": "#EBE4D8"
      },
      "selected-border": {
        "$type": "color",
        "$value": "#8A8175"
      }
    }
  },
  "component": {
    "$description": "Component-scoped tokens — use in component code",
    "button": {
      "primary-bg": {
        "$type": "color",
        "$value": "{semantic.action.primary}"
      },
      "primary-bg-hover": {
        "$type": "color",
        "$value": "{semantic.action.primary-hover}"
      },
      "primary-bg-active": {
        "$type": "color",
        "$value": "{semantic.action.primary-active}"
      },
      "primary-text": {
        "$type": "color",
        "$value": "{semantic.text.on-action}"
      },
      "secondary-bg": {
        "$type": "color",
        "$value": "{semantic.action.secondary}"
      },
      "secondary-bg-hover": {
        "$type": "color",
        "$value": "{semantic.action.secondary-hover}"
      },
      "secondary-text": {
        "$type": "color",
        "$value": "{semantic.text.primary}"
      },
      "tertiary-text": {
        "$type": "color",
        "$value": "{semantic.text.primary}"
      },
      "ghost-bg": {
        "$type": "color",
        "$value": "transparent"
      },
      "ghost-bg-hover": {
        "$type": "color",
        "$value": "{semantic.interactive.hover-overlay}"
      },
      "ghost-text": {
        "$type": "color",
        "$value": "{semantic.text.primary}"
      },
      "destructive-bg": {
        "$type": "color",
        "$value": "{semantic.action.destructive}"
      },
      "destructive-bg-hover": {
        "$type": "color",
        "$value": "{semantic.action.destructive-hover}"
      },
      "destructive-text": {
        "$type": "color",
        "$value": "{semantic.text.on-action}"
      },
      "disabled-bg": {
        "$type": "color",
        "$value": "{semantic.surface.disabled}"
      },
      "disabled-text": {
        "$type": "color",
        "$value": "{semantic.text.disabled}"
      }
    },
    "input": {
      "bg": {
        "$type": "color",
        "$value": "{semantic.surface.card}"
      },
      "bg-disabled": {
        "$type": "color",
        "$value": "{semantic.surface.disabled}"
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.border.strong}"
      },
      "border-focus": {
        "$type": "color",
        "$value": "{semantic.border.focus}"
      },
      "border-error": {
        "$type": "color",
        "$value": "{semantic.border.error}"
      },
      "text": {
        "$type": "color",
        "$value": "{semantic.text.primary}"
      },
      "placeholder": {
        "$type": "color",
        "$value": "{semantic.text.tertiary}"
      }
    },
    "card": {
      "bg": {
        "$type": "color",
        "$value": "{semantic.surface.card}"
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.border.default}"
      }
    }
  }
}
